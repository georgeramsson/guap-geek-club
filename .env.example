# ==============================================================================
# КОНФИГУРАЦИЯ ПРОЕКТА «СОЗВЕЗДИЕ» (ГУАП GEEK CLUB)
# ==============================================================================
# Скопируйте этот файл в .env.local:
# cp .env.example .env.local

# 1. ВЕРСИЯ NODE.JS ДЛЯ ДЕПЛОЯ НА RENDER (Обязательно для Next.js 16)
NODE_VERSION=20.18.0

# 2. ОБЛАЧНАЯ БАЗА ДАННЫХ SUPABASE (Необязательно для локального запуска)
# Если эти переменные не указаны, проект автоматически работает в локальном
# автономном режиме на файловой базе data/db.json.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 3. УВЕДОМЛЕНИЯ В TELEGRAM-ЧАТ КЛУБА (Необязательно)
# Токен бота (создается у @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# ID чата организаторов/мастеров, куда присылать уведомления о новых записях
TELEGRAM_CHAT_ID=-1001234567890
